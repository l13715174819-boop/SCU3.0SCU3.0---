{
  "name": "hotel",
  "description": "酒店住宿领域 — 价格/评分/评价结构化提取",
  "version": "1.0",
  "keywords": {
    "trigger": ["酒店", "住宿", "宾馆", "民宿", "公寓", "客栈", "motel", "hotel", "hostel", "inn", "住一晚", "入住", "订房"],
    "enhance": ["价格", "评价", "评分", "推荐", "多少钱"]
  },
  "query_rewrite": {
    "suffix": " 酒店 价格 评价 评分",
    "max_original_tokens": 30
  },
  "source_whitelist": [
    "hotels.ctrip.com",
    "hotel.qunar.com",
    "meituan.com/hotel",
    "dianping.com/hotel",
    "booking.com",
    "agoda.com",
    "ctrip.com/hotel",
    "qunar.com/hotel",
    "trip.com/hotel"
  ],
  "field_schema": {
    "price": {
      "patterns": [
        "￥([\\d,]+)\\s*(?:起|/晚|元)",
        "([\\d,]+)\\s*元\\s*(?:起|/晚)",
        "价格[:：\\s]*([\\d,]+)",
        "lowestPrice[\"']?\\s*[:：]\\s*[\"']?(\\d+)",
        "price[\"']?\\s*[:：]\\s*[\"']?(\\d+)"
      ],
      "type": "price"
    },
    "rating": {
      "patterns": [
        "评分[:：\\s]*([0-9.]+)\\s*(?:分)?",
        "([0-9]\\.[0-9])\\s*分",
        "rating[\"']?\\s*[:：]\\s*[\"']?([0-9.]+)",
        "score[\"']?\\s*[:：]\\s*[\"']?([0-9.]+)"
      ],
      "type": "rating"
    },
    "review_count": {
      "patterns": [
        "([\\d,]+)\\s*条\\s*(?:评价|点评|评论)",
        "([\\d,]+)\\s*reviews?",
        "reviewCount[\"']?\\s*[:：]\\s*[\"']?(\\d+)"
      ],
      "type": "int"
    },
    "hotel_name": {
      "patterns": [
        "<title[^>]*>([^|<]+?)\\s*(?:[|｜-]|\\s)\\s*(?:酒店|宾馆|公寓|民宿)",
        "([\\u4e00-\\u9fa5A-Za-z0-9]{2,20}(?:酒店|宾馆|公寓|民宿|客栈))"
      ],
      "type": "text"
    },
    "address": {
      "patterns": [
        "地址[:：\\s]*([^<\\n]{5,80})",
        "address[\"']?\\s*[:：]\\s*[\"']?([^\"'<>\\n]{5,80})"
      ],
      "type": "text"
    }
  },
  "ranking_strategy": {
    "boost_whitelist_source": 2.0,
    "boost_has_price": 1.5,
    "boost_has_rating": 1.2
  }
}
