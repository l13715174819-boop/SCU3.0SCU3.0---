{
  "name": "product",
  "description": "商品比价领域 — 电商多平台价格/销量/评分提取",
  "version": "1.0",
  "keywords": {
    "trigger": ["多少钱", "价格", "比价", "买", "购买", "便宜", "优惠", "折扣", "price", "商品", "规格"],
    "enhance": ["评价", "销量", "推荐"],
    "negative": ["酒店", "住宿", "宾馆", "民宿"]
  },
  "query_rewrite": {
    "suffix": " 价格 比价 评价 销量",
    "max_original_tokens": 30
  },
  "source_whitelist": [
    "item.jd.com",
    "jd.com",
    "detail.tmall.com",
    "item.taobao.com",
    "taobao.com",
    "tmall.com",
    "pinduoduo.com",
    "yangkeduo.com",
    "suning.com",
    "gome.com.cn"
  ],
  "field_schema": {
    "price": {
      "patterns": [
        "￥([\\d,]+(?:\\.\\d+)?)",
        "([\\d,]+(?:\\.\\d+)?)\\s*元",
        "price[\"']?\\s*[:：]\\s*[\"']?(\\d+(?:\\.\\d+)?)",
        "jdPrice[\"']?\\s*[:：]\\s*[\"']?(\\d+)",
        ".promo_price[\"']?\\s*[:：]\\s*[\"']?(\\d+)"
      ],
      "type": "price"
    },
    "sales": {
      "patterns": [
        "已售\\s*([\\d,]+)",
        "销量\\s*([\\d,]+)",
        "成交\\s*([\\d,]+)",
        "([\\d,]+)\\s*(?:人付款|人购买|人收货)"
      ],
      "type": "int"
    },
    "rating": {
      "patterns": [
        "([0-9]\\.[0-9])\\s*分",
        "好评率\\s*([0-9.]+)\\s*%",
        "rating[\"']?\\s*[:：]\\s*[\"']?([0-9.]+)"
      ],
      "type": "rating"
    },
    "product_name": {
      "patterns": [
        "<title[^>]*>([^|<]+?)\\s*(?:[|｜-]|\\s)\\s*(?:京东|天猫|淘宝|拼多多)",
        "([\\u4e00-\\u9fa5A-Za-z0-9\\s]{2,50})"
      ],
      "type": "text"
    },
    "shop": {
      "patterns": [
        "([\\u4e00-\\u9fa5A-Za-z0-9]{2,20}(?:旗舰店|专卖店|专营店|官方店))"
      ],
      "type": "text"
    }
  },
  "ranking_strategy": {
    "boost_whitelist_source": 2.0,
    "boost_has_price": 1.5,
    "boost_has_sales": 1.2
  }
}
